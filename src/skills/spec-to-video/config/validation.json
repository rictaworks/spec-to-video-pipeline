{
  "subtitle": {
    "max_chars_per_line": 20,
    "max_lines": 2,
    "min_display_sec": 1.2
  },
  "narration": {
    "default_speaker": "四国めたん（ノーマル）",
    "under_run_report_threshold_sec": 1
  },
  "excluded_terms": [
    "ソリューション",
    "シナジー",
    "パラダイム",
    "アジェンダ",
    "コミット"
  ],
  "dependent_prefixes": [
    "これ",
    "それ",
    "あれ",
    "この",
    "その",
    "あの",
    "こう",
    "そう",
    "また",
    "そして",
    "さらに",
    "つまり",
    "ただし",
    "しかし",
    "そのため",
    "こちら",
    "そちら"
  ],
  "transition": {
    "kinds": [
      "cross_dissolve",
      "cut",
      "dip_to_black",
      "dip_to_white"
    ],
    "luminance_changing_kinds": [
      "dip_to_black",
      "dip_to_white"
    ],
    "max_kinds_per_video": 3,
    "max_ratio_of_cut_duration": 0.2
  },
  "direction": {
    "motion_easing": [
      "ease",
      "linear",
      "hold"
    ],
    "blend_modes": [
      "normal",
      "multiply",
      "screen",
      "add"
    ],
    "luminance_raising_blend_modes": [
      "screen",
      "add"
    ],
    "telop_patterns": [
      "multi_outline",
      "plain"
    ]
  }
}
