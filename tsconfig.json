{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src/**/*.js",
    "scripts/**/*.js",
    "test/**/*.js",
    "types/**/*.d.ts"
  ]
}
